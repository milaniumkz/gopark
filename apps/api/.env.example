NODE_ENV=development
APP_RUNTIME=api
PORT=3000
API_PREFIX=api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gopark
REDIS_URL=redis://localhost:6379
AUTH_TOKEN_SECRET=change-me-before-production
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=1800
AUTH_REFRESH_RATE_LIMIT_ATTEMPTS=30
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REFRESH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_LOGOUT_RATE_LIMIT_ATTEMPTS=30
AUTH_LOGOUT_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGOUT_RATE_LIMIT_BLOCK_SECONDS=900
ALLOW_INSECURE_BOOTSTRAP_AUTH=true
ALLOW_IN_MEMORY_PRODUCTION=false
HTTP_REQUEST_LOGGING=true
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
